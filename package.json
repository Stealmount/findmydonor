{
  "name": "lahu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx backend/server.ts",
    "dev:admin": "tsx backend/admin-server.ts",
    "build": "vite build && vite build --config vite.admin.config.ts && esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild backend/admin-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/admin-server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test backend/tests/auth.test.ts backend/tests/matching.test.ts backend/tests/simulator.test.ts backend/tests/hospital.test.ts backend/tests/admin.test.ts",
    "test:auth": "tsx --test backend/tests/auth.test.ts",
    "test:matching": "tsx --test backend/tests/matching.test.ts",
    "test:security": "tsx --test backend/tests/security.test.ts",
    "test:all": "tsx --test backend/tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "resend": "^6.16.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
