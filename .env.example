# Public application URL used for same-origin API requests and generated links.
APP_URL=http://localhost:5000
# Optional comma-separated extra origins allowed to call /api routes.
CORS_ORIGINS=

# Browser-safe Supabase values. These are required by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never prefix this key with VITE_ and never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp delivery. The server refuses to claim delivery if WAHA is unavailable.
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
# WAHA dashboard/swagger login (used by docker-compose.yml)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
REDIS_URL=redis://localhost:6379

# RESEND_API_KEY: Resend service API key for transactional emails
RESEND_API_KEY=

# RESEND_SENDER_EMAIL: Verified sender email address in Resend (defaults to onboarding@resend.dev)
RESEND_SENDER_EMAIL=


