# Public application URL used for same-origin API requests and generated links.
APP_URL=http://localhost:5000
# Port for the isolated admin server.

# Server-only. Never prefix this key with VITE_ and never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin console access key — the secret that unlocks /api/admin/* routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The frontend sends it to POST /api/admin/verify-key and keeps it in sessionStorage.
ADMIN_AUTH_SECRET=
# Comma-separated admin emails allowed to use /api/admin/* via Supabase session.
ADMIN_EMAILS=admin@raktdaan.org

# WhatsApp delivery. The server refuses to claim delivery if WAHA is unavailable.
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
# WAHA dashboard/swagger login (used by docker-compose.yml)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
REDIS_URL=redis://localhost:6379
# WAHA webhook secret — set this in your WAHA dashboard under webhook settings as a
# custom header value (X-Waha-Token: <your-secret>). The server rejects all webhook
# POST requests that don't carry this header. Leave blank/unset in local dev to skip.
WAHA_WEBHOOK_SECRET=

# RESEND_API_KEY: Resend service API key for transactional emails
RESEND_API_KEY=

# RESEND_SENDER_EMAIL: Verified sender email address in Resend (e.g. FindMyDonor <official@findmydonor.online>)
RESEND_SENDER_EMAIL="FindMyDonor <official@findmydonor.online>"

# ─── Messaging queue (centralized outbound delivery) ────────────────────────
# Minimum delay before any non-OTP message is sent (seconds). OTP uses 0.
MESSAGE_DELAY_SECONDS=60
# Worker poll cadence (ms).
MESSAGE_POLL_INTERVAL_MS=5000
# Max delivery attempts before a message is marked failed.
MESSAGE_MAX_RETRIES=5
# Reclaim processing rows after a crash (seconds).
# Public application URL used for same-origin API requests and generated links.
APP_URL=http://localhost:5000
# Port for the isolated admin server.

# Server-only. Never prefix this key with VITE_ and never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin console access key — the secret that unlocks /api/admin/* routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The frontend sends it to POST /api/admin/verify-key and keeps it in sessionStorage.
ADMIN_AUTH_SECRET=
# Comma-separated admin emails allowed to use /api/admin/* via Supabase session.
ADMIN_EMAILS=admin@raktdaan.org

# WhatsApp delivery. The server refuses to claim delivery if WAHA is unavailable.
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
# WAHA dashboard/swagger login (used by docker-compose.yml)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
REDIS_URL=redis://localhost:6379
# WAHA webhook secret — set this in your WAHA dashboard under webhook settings as a
# custom header value (X-Waha-Token: <your-secret>). The server rejects all webhook
# POST requests that don't carry this header. Leave blank/unset in local dev to skip.
WAHA_WEBHOOK_SECRET=

# RESEND_API_KEY: Resend service API key for transactional emails
RESEND_API_KEY=

# RESEND_SENDER_EMAIL: Verified sender email address in Resend (e.g. FindMyDonor <official@findmydonor.online>)
RESEND_SENDER_EMAIL="FindMyDonor <official@findmydonor.online>"

# ─── Messaging queue (centralized outbound delivery) ────────────────────────
# Minimum delay before any non-OTP message is sent (seconds). OTP uses 0.
MESSAGE_DELAY_SECONDS=60
# Worker poll cadence (ms).
MESSAGE_POLL_INTERVAL_MS=5000
# Max delivery attempts before a message is marked failed.
MESSAGE_MAX_RETRIES=5
# Reclaim processing rows after a crash (seconds).
MESSAGE_CLAIM_STALE_SECONDS=120

# ─── Onboarding & notifications (auth redesign, Phase 1) ─────────────────────
# Delay before the welcome notification is sent after account creation (seconds).
# Never hardcoded — must come from config.
WELCOME_DELAY_SECONDS=30
# Default communication preference for new users (whatsapp | email | both).
# This is reused by EVERY notification path (welcome, donor alerts, request
# updates, institution notifications, broadcasts).
NOTIFICATION_DEFAULT_CHANNEL=both

# ─── Environment & CORS Configuration ───────────────────────────────────────
# Runtime environment: development | production | test
NODE_ENV=development
# Comma-separated list of allowed CORS origins (no wildcard * in production)
CORS_ORIGINS=https://findmydonor.online,https://www.findmydonor.online,http://localhost:5173,http://localhost:5000,http://localhost:3000,http://localhost:6001,http://localhost:7000,http://127.0.0.1:5173,http://127.0.0.1:5000,http://127.0.0.1:3000,http://127.0.0.1:6001,http://127.0.0.1:7000
